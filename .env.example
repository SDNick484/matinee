# Matinee settings. In production these live in /etc/conf.d/matinee (written by the installer, exported by the
# OpenRC script). For local development the app also reads a .env next to app.py (copy this file);
# variables already in the environment win.

# Port gunicorn / the dev server listens on (each app on the host needs its own)
PORT=8771
# Where matinee.db and images/ live (default: ./data next to app.py)
DATA_DIR=/var/lib/matinee

# TMDB v3 API Read Access Token (themoviedb.org -> Settings -> API). Adding movies is off until it is set.
TMDB_READ_TOKEN=

# Optional OMDb API key (omdbapi.com/apikey.aspx) for IMDb, Rotten Tomatoes & Metacritic ratings
OMDB_API_KEY=

# Cloudflare Access team domain, e.g. yourteam.cloudflareaccess.com (copied from /etc/conf.d/cookbooks)
CF_TEAM_DOMAIN=
# Application Audience (AUD) tag of the Access app that protects /admin
CF_AUD=
# Comma-separated editor emails; empty = anyone Access lets through (copied from /etc/conf.d/cookbooks)
ADMIN_EMAILS=
# 1 = direct requests on the LAN (not via the tunnel) may edit without signing in
LAN_EDIT=1
# Host names LAN editing may use besides IP addresses and localhost, e.g. matinee.lan (comma-separated, no port)
LAN_HOSTS=
# 1 = / and /api are open to anyone; 0 = / redirects to /admin and /api answers 403
PUBLIC_VIEW=1

# Optional API key for headless automation and MCP server (Authorization: Bearer <key> or X-API-Key: <key>)
MATINEE_API_KEY=
# Key that may only GET /admin/api (watch notes included), never write; matinee-mcp uses it while read-only.
# The installer generates one; it must differ from MATINEE_API_KEY
MATINEE_READ_KEY=

# Anthropic API key for Ask (plain-language search, /admin#/ask); empty = Ask is off. Use a key from its own Console workspace with a spend limit
ANTHROPIC_SEARCH_KEY=
# Model Ask uses
ANTHROPIC_SEARCH_MODEL=claude-haiku-5-5
# Questions per day across all editors; past it Ask answers 429 until local midnight
ASK_DAILY_LIMIT=200
# Home Assistant webhook URL, e.g. http://homeassistant.local:8123/api/webhook/<id>; a watch logged for today is POSTed
# to it as JSON (docs/home-assistant.md). A SECRET: the id in the URL is the only credential. Empty = off
HA_WEBHOOK_URL=
# The family Wish Lists app on this host. "Add to a wish list…" on a wanted movie pushes it there over localhost; the
# button shows only while the app answers here (default http://127.0.0.1:8766)
WISHLIST_URL=http://127.0.0.1:8766
# Shopping search link put on a pushed wish; {q} becomes the title, year and wanted format, e.g. Spirited Away 2001 4K UHD
WISHLIST_MOVIE_URL=https://www.amazon.com/s?k={q}
# --- Remote MCP (matinee-mcp): the Claude app reaches Matinee through Cloudflare Access -----------------
# 1 = the remote MCP service exposes only read tools (MATINEE_MCP_WRITES is ignored); 0 = MATINEE_MCP_WRITES decides
MATINEE_MCP_READONLY=1
# What the service may write while MATINEE_MCP_READONLY=0: none = read tools only, log = also rate_movie and
# log_watch, all = also add_movie. Unknown values mean none; unset with READONLY=0 means all
MATINEE_MCP_WRITES=none
# Port matinee-mcp listens on (after Pixelcade's 8718)
MCP_HTTP_PORT=8719
# Address matinee-mcp listens on: the host's LAN address, because cloudflared runs in a container (127.0.0.1 would 502)
MCP_HTTP_BIND=192.168.1.100
# Endpoint path; the tunnel route ^/matinee/ does not strip it
MCP_HTTP_PATH=/matinee/mcp
# Public hostname the tunnel forwards (required, otherwise HTTP 421)
MCP_PUBLIC_HOSTS=mcp.example.com
# AUD tag of the Access app that covers mcp.example.com (this is NOT CF_AUD, the /admin app's tag);
# matinee-mcp uses CF_TEAM_DOMAIN above for the team domain
CF_ACCESS_AUD=
# Comma-separated Access emails allowed to use the MCP endpoint; empty = anyone the Access policy lets in
MCP_ALLOWED_EMAILS=
